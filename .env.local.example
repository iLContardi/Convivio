# Copia questo file in `.env.local` e riempi i valori.
# `.env.local` non finisce mai in git né nel browser: le chiavi restano server-side.
# Nel database salviamo solo il NOME di queste variabili, mai il loro contenuto.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Percorso del file SQLite. Relativo alla radice del progetto.
DATABASE_PATH=./data/convivio.db
